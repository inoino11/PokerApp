@inherits LayoutComponentBase
@inject IJSRuntime JS

<MudThemeProvider @ref="_theme" Theme="_appTheme" IsDarkMode="_isDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        @Body
    </ChildContent>
    <ErrorContent>
        <div class="error-panel">
            <ChipmunkMark />
            <MudText Typo="Typo.h6">問題が発生</MudText>
            <MudText Typo="Typo.body2">ゲームの状態は端末に保存済み</MudText>
            <div class="d-flex gap-2 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Recover">トップに戻る</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="Reload">再読み込み</MudButton>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private MudThemeProvider? _theme;
    private ErrorBoundary? _errorBoundary;
    private bool _isDark;

    private readonly MudTheme _appTheme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#1b6e3c", Secondary = "#b8860b", AppbarBackground = "#1b6e3c" },
        PaletteDark = new PaletteDark { Primary = "#4caf6e", Secondary = "#e0b84a", AppbarBackground = "#163b25" },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_theme is not null)
        {
            _isDark = await _theme.GetSystemDarkModeAsync();
            await _theme.WatchSystemDarkModeAsync(OnSystemDarkModeChanged);
            StateHasChanged();
        }
        await JS.InvokeVoidAsync("appLoading.hide");
    }

    private Task OnSystemDarkModeChanged(bool isDark)
    {
        _isDark = isDark;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Recover() => _errorBoundary?.Recover();

    private async Task Reload() => await JS.InvokeVoidAsync("location.reload");
}
