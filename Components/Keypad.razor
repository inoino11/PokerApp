@* 画面に描くテンキー。OS のキーボードを出さずに額を入れる。最初に押した数字で前の値を置き換える *@
<div class="keypad">
    @foreach (var key in Keys)
    {
        <button type="button" class="keypad-key @(key is "←" or "C" ? "keypad-fn" : "")" @onclick="() => Press(key)">@key</button>
    }
    <button type="button" class="keypad-key keypad-done" @onclick="OnDone">決定</button>
</div>

@code {
    private static readonly string[] Keys = ["7", "8", "9", "C", "4", "5", "6", "←", "1", "2", "3", "00", "0", "000"];
    private const long Limit = 1_000_000_000_000;
    private bool _fresh = true;

    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter] public EventCallback OnDone { get; set; }

    private async Task Press(string key)
    {
        var v = _fresh && key is not ("←" or "C") ? 0 : Value;
        _fresh = false;
        v = key switch
        {
            "C" => 0,
            "←" => v / 10,
            "00" => v * 100,
            "000" => v * 1000,
            _ => v * 10 + (key[0] - '0'),
        };
        if (v >= Limit) return;
        await ValueChanged.InvokeAsync(v);
    }
}
