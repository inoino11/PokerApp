@* ブラインドのレベルと時計。レベルは左右の矢印で上げ下げし、残り時間は時刻をタップして開くメニューで変える。
   最終レベルでは時計を進める意味がないので、時刻と再生・一時停止のボタンを出さない *@
<div class="clock-bar">
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Class="clock-step" Disabled="LevelIndex == 0"
                   OnClick="() => OnLevelDelta.InvokeAsync(-1)" aria-label="レベルを下げる" />
    @* 「次のハンドから」は札にすると帯の横幅が足りなくなるので、額の下に小さく出す *@
    <div class="clock-level">
        <div class="clock-main">
            <span class="clock-lv">Lv@(LevelIndex + 1)</span>
            <span class="clock-blinds">@Chips.Format(Level)</span>
        </div>
        @if (NextHandLevel)
        {
            <span class="clock-next">次のハンドから</span>
        }
        else if (NextLevel is not null)
        {
            @* 「次のハンドから」と同じ 2 行目に出す。両方出すと帯が高くなるので、そちらがあるときは出さない *@
            <span class="clock-upcoming">Next @Chips.Format(NextLevel)</span>
        }
    </div>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="clock-step" Disabled="IsLastLevel"
                   OnClick="() => OnLevelDelta.InvokeAsync(1)" aria-label="レベルを上げる" />

    <MudSpacer />

    @if (ShowClock && IsLastLevel)
    {
        <span class="clock-last">最終レベル</span>
    }
    else if (ShowClock)
    {
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <span class="clock-time @(!Running ? "clock-paused" : Remaining <= TimeSpan.FromMinutes(1) ? "clock-soon" : "")" @onclick="e => context.ToggleAsync(e)">
                    @($"{(int)Remaining.TotalMinutes:00}:{Remaining.Seconds:00}")
                </span>
            </ActivatorContent>
            <ChildContent>
                <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="() => OnMinutesDelta.InvokeAsync(1)">+1分</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Remove" OnClick="() => OnMinutesDelta.InvokeAsync(-1)">-1分</MudMenuItem>
            </ChildContent>
        </MudMenu>
        <MudIconButton Icon="@(Running ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                       Color="@(Running ? Color.Default : Color.Primary)" Variant="@(Running ? Variant.Text : Variant.Filled)"
                       Size="Size.Medium" Class="clock-toggle" OnClick="OnToggle" aria-label="@(Running ? "一時停止" : "再開")" />
    }
</div>

@code {
    [Parameter] public int LevelIndex { get; set; }
    [Parameter, EditorRequired] public BlindLevel Level { get; set; } = default!;
    [Parameter] public bool IsLastLevel { get; set; }
    [Parameter] public bool ShowClock { get; set; }
    [Parameter] public bool Running { get; set; }
    [Parameter] public TimeSpan Remaining { get; set; }
    [Parameter] public bool NextHandLevel { get; set; }  // 進行中のハンドとレベルが違う
    [Parameter] public BlindLevel? NextLevel { get; set; }  // 時間で上がる次のレベル。null なら出さない
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback<int> OnLevelDelta { get; set; }
    [Parameter] public EventCallback<int> OnMinutesDelta { get; set; }
}
