@* 精算表。バイインとリバイの合計と、今の手元の差 *@
<MudDialog>
    <TitleContent>精算表</TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true" Hover="false" Class="ledger">
            <thead>
                <tr>
                    <th>名前</th>
                    <th class="num">購入</th>
                    <th class="num">手元</th>
                    <th class="num">差</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in State.Players)
                {
                    var now = Holding(p);
                    <tr class="@(p.Status == PlayerStatus.Left ? "ledger-left" : "")">
                        <td>@p.Name@(p.Status == PlayerStatus.Left ? "（退席）" : "")</td>
                        <td class="num">@Chips.Format(p.BuyIn)</td>
                        <td class="num">@Chips.Format(now)</td>
                        <td class="num @(now - p.BuyIn > 0 ? "plus" : now - p.BuyIn < 0 ? "minus" : "")">@Signed(now - p.BuyIn)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td>合計</td>
                    <td class="num">@Chips.Format(State.Players.Sum(p => p.BuyIn))</td>
                    <td class="num">@Chips.Format(State.Players.Sum(Holding))</td>
                    <td class="num">@Signed(State.Players.Sum(p => Holding(p) - p.BuyIn))</td>
                </tr>
            </tfoot>
        </MudSimpleTable>
        @if (State.Hand is not null)
        {
            <MudText Typo="Typo.caption" Class="d-block mt-2">ハンドの途中なので、手元にはポットに出した分を含めています。</MudText>
        }
        <MudText Typo="Typo.caption" Class="d-block mt-2">「合計」の差が 0 でないときは、額を手で直した分があります。</MudText>
        <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-3">@Notices.NoGambling</MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Close()">閉じる</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;

    private long Holding(Player p) => p.Stack + (State.Hand?.Seats.FirstOrDefault(x => x.PlayerId == p.Id)?.Contributed ?? 0);

    private static string Signed(long v) => v > 0 ? "+" + Chips.Format(v) : Chips.Format(v);
}
