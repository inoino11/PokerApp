@* 席の一覧。次に行動する人を強調する。行をタップするとプレイヤーのメニューを開く *@
<div class="player-list">
    @foreach (var p in State.Seated)
    {
        var seat = Hand?.Seats.FirstOrDefault(x => x.PlayerId == p.Id);
        var toAct = Hand?.ToActId == p.Id;
        <div class="player-row @RowClass(p, seat, toAct)" @onclick="() => OnPlayerClick.InvokeAsync(p.Id)">
            <span class="player-color" style="background:@Chips.PlayerColors[p.ColorIndex % Chips.PlayerColors.Length]"></span>
            <div class="player-main">
                <div class="player-name">
                    @p.Name
                    @foreach (var badge in Badges(p.Id))
                    {
                        <span class="player-badge @(badge == "D" ? "badge-d" : "")">@badge</span>
                    }
                </div>
                <div class="player-state">@StateText(p, seat)</div>
            </div>
            <div class="player-bet">
                @if (seat is { StreetBet: > 0 })
                {
                    <span class="bet-chip">@Chips.Format(seat.StreetBet)</span>
                }
            </div>
            <div class="player-stack">@Chips.Format(p.Stack)</div>
        </div>
    }

    @if (State.Seated.Count() < GameState.MaxSeats)
    {
        <button type="button" class="player-add" @onclick="OnAdd">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
            プレイヤーを追加（@Chips.Format(State.Settings.StartingStack)）
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public EventCallback<int> OnPlayerClick { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }

    private HandState? Hand => State.Hand;

    private IEnumerable<string> Badges(int id)
    {
        if (Hand is null) yield break;
        if (Hand.ButtonId == id) yield return "D";
        string[] names = ["SB", "BB", "3rd"];
        for (var i = 0; i < Hand.BlindIds.Count; i++)
            if (Hand.BlindIds[i] == id) yield return names[i];
    }

    private static string RowClass(Player p, HandSeat? seat, bool toAct) =>
        toAct ? "row-to-act"
        : p.Status != PlayerStatus.Active && seat is null ? "row-out"
        : seat is { Folded: true } ? "row-folded"
        : "";

    private string StateText(Player p, HandSeat? seat)
    {
        if (seat is { Folded: true }) return "Fold";
        if (seat is { AllIn: true }) return "All-in";
        if (p.Status == PlayerStatus.SittingOut) return p.Stack == 0 ? "離席中（チップなし）" : "離席中";
        if (Hand is not null && seat is null) return "次のハンドから";
        if (Hand?.ToActId == p.Id) return "手番";
        return "";
    }
}
