@* 席の一覧。次に行動する人を強調する。行をタップするとプレイヤーのメニューを開く。
   席替えモードでは行の右端のつまみをドラッグして並べ替える（ドラッグは wwwroot/js/app.js の seatDrag が受け持つ） *@
<div class="player-list @(SeatMode ? "seat-mode" : "")">
    @* 人数で位置が変わらないよう一覧の上に置く（下だと続けて追加するとき、足したばかりの人の行を押してしまう） *@
    <div class="list-tools">
        @if (SeatMode)
        {
            <span class="seat-hint">≡ をつかんで上下に移動</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="() => SeatModeChanged.InvokeAsync(false)">完了</MudButton>
        }
        else
        {
            @if (State.Seated.Count() < GameState.MaxSeats)
            {
                <button type="button" class="list-btn player-add" @onclick="OnAdd">
                    <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" />
                    追加（@Chips.Format(State.Settings.StartingStack)）
                </button>
            }
            @* 2 人そろってから出すと「追加」の幅が縮んで位置がずれるので、最初から出して押せなくしておく。
               ハンドの途中は押せても入らない（理由は親が知らせる） *@
            <button type="button" class="list-btn seat-toggle @(Hand is null ? "" : "seat-locked")" disabled="@(State.Seated.Count() < 2)"
                    @onclick="() => SeatModeChanged.InvokeAsync(true)">
                <MudIcon Icon="@Icons.Material.Filled.SwapVert" Size="Size.Small" />
                席替え
            </button>
        }
    </div>

    @* 誰もいない卓だけに、シマリスを薄く置く（ゲームが始まれば消える） *@
    @if (!SeatMode && !State.Seated.Any())
    {
        <div class="empty-table"><ChipmunkMark /></div>
    }

    @foreach (var p in State.Seated)
    {
        var seat = Hand?.Seats.FirstOrDefault(x => x.PlayerId == p.Id);
        var toAct = Hand?.ToActId == p.Id;
        <div @key="p.Id" class="player-row @RowClass(p, seat, toAct)" @onclick="() => RowClicked(p.Id)">
            <span class="player-color" style="background:@Chips.PlayerColors[p.ColorIndex % Chips.PlayerColors.Length]"></span>
            <div class="player-main">
                <div class="player-name">@p.Name</div>
                @* 札は名前の後ろに付けると名前の長さで位置がずれるので、2 行目の左端にそろえる *@
                <div class="player-state">
                    @foreach (var badge in Badges(p.Id))
                    {
                        <span class="player-badge @(badge switch { "D" => "badge-d", "次D" => "badge-next", _ => "" })">@badge</span>
                    }
                    @StateText(p, seat)
                </div>
            </div>
            <div class="player-bet">
                @if (seat is { StreetBet: > 0 })
                {
                    <span class="bet-chip">@Chips.Format(seat.StreetBet)</span>
                }
            </div>
            <div class="player-stack-col">
                <div class="player-stack">@Chips.Format(p.Stack)</div>
                <div class="player-bb">@Chips.FormatBb(p.Stack, BigBlind)</div>
            </div>
            @if (SeatMode)
            {
                <span class="seat-handle" aria-label="@(p.Name) をドラッグして移動">
                    <MudIcon Icon="@Icons.Material.Filled.DragHandle" />
                </span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public EventCallback<int> OnPlayerClick { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public bool SeatMode { get; set; }
    [Parameter] public EventCallback<bool> SeatModeChanged { get; set; }
    [Parameter] public long BigBlind { get; set; }  // スタックの BB 換算に使う

    private HandState? Hand => State.Hand;

    private Task RowClicked(int id) => SeatMode ? Task.CompletedTask : OnPlayerClick.InvokeAsync(id);

    private IEnumerable<string> Badges(int id)
    {
        // ハンドの合間は次のボタンを見せる（席替えでボタンが誰に移るかを確かめられるように）
        if (Hand is null)
        {
            if (GameEngine.NextButtonId(State) == id) yield return "次D";
            yield break;
        }
        if (Hand.ButtonId == id) yield return "D";
        string[] names = ["SB", "BB", "3rd"];
        for (var i = 0; i < Hand.BlindIds.Count; i++)
            if (Hand.BlindIds[i] == id) yield return names[i];
    }

    private string RowClass(Player p, HandSeat? seat, bool toAct) =>
        toAct ? "row-to-act"
        : seat is null && (Hand is not null || p.Status != PlayerStatus.Active) ? "row-out"
        : seat is { Folded: true } ? "row-folded"
        : "";

    private string StateText(Player p, HandSeat? seat)
    {
        if (seat is { Folded: true }) return "Fold";
        if (seat is { AllIn: true }) return "All-in";
        if (p.Status == PlayerStatus.SittingOut) return p.Stack == 0 ? "離席中（チップなし）" : "離席中";
        if (Hand is not null && seat is null) return "次のハンドから";
        return "";
    }
}
