@* プレイヤーのメニュー。名前と手元の額は「確定」でまとめて変え、離席・退席はボタンですぐ変える。結果は 1 つの GameCommand で返す *@
<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <span class="dlg-color" style="background:@Chips.PlayerColors[Player.ColorIndex % Chips.PlayerColors.Length]"></span>
            @Player.Name
        </div>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="名前" Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="12" />

        @* 数値として読めない内容で確定したら、直前に読めた値へ戻す *@
        <MudTextField @ref="_stackField" T="string" Value="_stackText" ValueChanged="OnStackTextChanged" Label="手元のチップ"
                      Variant="Variant.Outlined" Margin="Margin.Dense" InputMode="InputMode.numeric" Class="mt-3 dlg-stack-input"
                      Disabled="Player.Status == PlayerStatus.Left" />
        @if (Player.Status != PlayerStatus.Left)
        {
            <div class="d-flex gap-1 mt-2">
                @foreach (var add in QuickAdds)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetStack(_stack + add)">+@Chips.Format(add)</MudButton>
                }
            </div>
        }

        <MudDivider Class="my-3" />

        <div class="d-flex flex-wrap gap-2">
            @if (CanBeButton)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => Close(new ChooseButton(Player.Id))">次のハンドの D にする</MudButton>
            }
            @if (Player.Status == PlayerStatus.SittingOut)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Player.Stack <= 0"
                           OnClick="() => Close(new SetStatus(Player.Id, PlayerStatus.Active))">着席</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Disabled="InPot" OnClick="() => Close(new SetStatus(Player.Id, PlayerStatus.SittingOut))">一時離席</MudButton>
            }
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="InPot"
                       OnClick="() => Close(new SetStatus(Player.Id, PlayerStatus.Left))">退席</MudButton>
        </div>
        @if (InPot)
        {
            <div class="dlg-note">ポットに参加中のため、このハンドが終わるまで抜けられない</div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => MudDialog.Cancel()">キャンセル</MudButton>
        @* 入力欄の内容は欄を離れたときに伝わるので、押せない状態にはしない（入力中に押しても受け付ける） *@
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">確定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] public IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter, EditorRequired] public GameState State { get; set; } = default!;
    [Parameter] public int PlayerId { get; set; }

    private string _name = "";
    private long _stack;
    private string _stackText = "";
    private MudTextField<string>? _stackField;

    private Player Player => State.GetPlayer(PlayerId);
    private bool InPot => GameEngine.IsInPot(State, PlayerId);
    private bool CanBeButton => State.Hand is null && GameEngine.NextButtonId(State) is int next && next != PlayerId
        && GameEngine.Eligible(State).Any(p => p.Id == PlayerId);
    private long[] QuickAdds => [State.Settings.StartingStack / 2, State.Settings.StartingStack];

    protected override void OnInitialized()
    {
        _name = Player.Name;
        SetStack(Player.Stack);
    }

    private void SetStack(long stack)
    {
        _stack = stack;
        _stackText = Chips.Format(stack);
    }

    // 確定した内容と表示する文字列が同じだと MudTextField は表示を書き戻さないので、自分で書き直す
    private async Task OnStackTextChanged(string text)
    {
        SetStack(Chips.TryParse(text, out var v) ? v : _stack);
        if (_stackField is not null) await _stackField.SetTextAsync(_stackText);
    }

    // 名前を空にしたときは元の名前のまま。何も変えていなければ履歴に積まずに閉じる
    private void Confirm()
    {
        var name = string.IsNullOrWhiteSpace(_name) ? Player.Name : _name.Trim();
        if (name == Player.Name && _stack == Player.Stack) MudDialog.Cancel();
        else Close(new EditPlayer(Player.Id, name, _stack));
    }

    private void Close(GameCommand command) => MudDialog.Close(DialogResult.Ok(command));
}
